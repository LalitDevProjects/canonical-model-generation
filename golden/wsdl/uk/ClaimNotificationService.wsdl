<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                   xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
                   xmlns:xs="http://www.w3.org/2001/XMLSchema"
                   xmlns:tns="urn:claims:uk:notification"
                   targetNamespace="urn:claims:uk:notification">

  <!-- WSDL is treated purely as an XSD-type carrier (Section 4.4): the
       platform extracts the embedded schema and ignores the operation
       wrapper for attribute-extraction purposes. This one trivial
       operation exists only to make the fixture a realistic, minimal
       WSDL document, not because operations/bindings/ports are
       themselves a source of attribute records. -->
  <wsdl:types>
    <xs:schema targetNamespace="urn:claims:uk:notification"
               xmlns:tns="urn:claims:uk:notification"
               elementFormDefault="qualified">

      <xs:element name="BaseNotificationEvent" type="tns:BaseNotificationEventType"/>
      <xs:element name="UrgentNotificationEvent" substitutionGroup="tns:BaseNotificationEvent" type="tns:UrgentNotificationEventType"/>

      <xs:complexType name="BaseNotificationEventType">
        <xs:sequence>
          <xs:element name="eventId" type="xs:string"/>
        </xs:sequence>
      </xs:complexType>

      <xs:complexType name="UrgentNotificationEventType">
        <xs:complexContent>
          <xs:extension base="tns:BaseNotificationEventType">
            <xs:sequence>
              <xs:element name="receivedAt" type="xs:dateTime"/>
              <xs:element name="escalationReason" type="xs:string"/>
            </xs:sequence>
          </xs:extension>
        </xs:complexContent>
      </xs:complexType>

      <xs:element name="ClaimNotification">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="notificationDate" type="xs:string">
              <xs:annotation>
                <xs:documentation>Date the notification was received.</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name="claimReferenceCode" type="xs:string"/>
            <xs:element name="settlementNote" type="xs:string" nillable="true"/>
            <xs:element name="priorClaimReference" type="xs:string" minOccurs="0"/>
            <xs:choice id="notifier">
              <xs:element name="brokerNotifier" type="tns:BrokerNotifierType"/>
              <xs:element name="policyholderNotifier" type="tns:PolicyholderNotifierType"/>
              <xs:element name="thirdPartyNotifier" type="tns:ThirdPartyNotifierType"/>
            </xs:choice>
          </xs:sequence>
          <xs:attribute name="claimReference" type="xs:string" use="required"/>
        </xs:complexType>
      </xs:element>

      <xs:complexType name="BrokerNotifierType">
        <xs:sequence>
          <xs:element name="brokerReference" type="xs:string"/>
          <xs:element name="brokerName" type="xs:string"/>
        </xs:sequence>
      </xs:complexType>

      <xs:complexType name="PolicyholderNotifierType">
        <xs:sequence>
          <xs:element name="policyholderId" type="xs:string"/>
          <xs:element name="contactPhone" type="xs:string"/>
        </xs:sequence>
      </xs:complexType>

      <xs:complexType name="ThirdPartyNotifierType">
        <xs:sequence>
          <xs:element name="thirdPartyName" type="xs:string"/>
          <xs:element name="relationshipToInsured" type="xs:string"/>
        </xs:sequence>
      </xs:complexType>

    </xs:schema>
  </wsdl:types>

  <wsdl:message name="SubmitClaimNotificationRequest">
    <wsdl:part name="notification" element="tns:ClaimNotification"/>
  </wsdl:message>

  <wsdl:portType name="ClaimNotificationPortType">
    <wsdl:operation name="SubmitClaimNotification">
      <wsdl:input message="tns:SubmitClaimNotificationRequest"/>
    </wsdl:operation>
  </wsdl:portType>

</wsdl:definitions>

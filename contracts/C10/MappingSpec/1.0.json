{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canonicalmodel.internal/contracts/C10/MappingSpec/1.0.json",
  "title": "C10 MappingSpec",
  "description": "INTERPRETED, NOT VERBATIM SPEC: the spec gives an EBNF grammar for a YAML-like mapping DSL (Section 10.2) plus a worked example, not a JSON Schema. This schema is my translation of that grammar into the parsed-document shape, since the contract catalogue (Section 3.1) states all eleven contracts are published as JSON Schema 2020-12. Revise once Increment 9 (mapping DSL) implements the actual grammar parser/interpreter. The mappings[].oneOf(transform, disposition) directly encodes invariant I5: every entry carries either a transform (mapped) or a disposition with status unmapped/escalated and a reason - omission is a validation error.",
  "type": "object",
  "additionalProperties": false,
  "required": ["header", "mappings"],
  "properties": {
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mappingSpecId", "canonicalRef", "direction", "generatedFrom"],
      "properties": {
        "mappingSpecId": { "type": "string" },
        "canonicalRef": { "type": "string" },
        "direction": {
          "type": "string",
          "enum": ["bidirectional", "toCanonical", "fromCanonical"]
        },
        "generatedFrom": {
          "type": "object",
          "additionalProperties": false,
          "required": ["run", "corpusManifest", "agent"],
          "properties": {
            "run": { "$ref": "../../common/defs.json#/$defs/uuid" },
            "corpusManifest": { "type": "string" },
            "agent": { "type": "string" }
          }
        }
      }
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["canonical", "evidence"],
        "properties": {
          "canonical": { "type": ["string", "null"] },
          "region": { "type": "string" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "../../common/defs.json#/$defs/evidenceRef" }
          },
          "transform": { "type": "string", "description": "Closed transform-vocabulary invocation, e.g. parseDate(...) or toMonetaryAmount(...)." },
          "disposition": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "reason"],
            "properties": {
              "status": { "type": "string", "enum": ["unmapped", "escalated"] },
              "reason": { "type": "string" },
              "confirmedBy": { "type": "string" }
            }
          },
          "obligation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "canonical": { "type": "string", "enum": ["mandatory", "conditional", "optional", "absent"] },
              "region": { "type": "string", "enum": ["mandatory", "conditional", "optional", "absent"] }
            }
          },
          "weight": { "type": "integer", "enum": [5, 3, 1] },
          "onFailure": { "type": "string", "enum": ["reject", "escalate", "default", "skip"] },
          "identifierScheme": { "type": "string" },
          "placement": { "type": "string", "enum": ["core", "extension"] },
          "note": { "type": "string" }
        },
        "oneOf": [
          { "required": ["transform"], "not": { "required": ["disposition"] } },
          { "required": ["disposition"], "not": { "required": ["transform"] } }
        ]
      }
    },
    "valueMaps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mappings"],
        "properties": {
          "mappings": { "type": "object", "additionalProperties": { "type": "string" } },
          "unmappedValues": { "type": "string", "enum": ["escalate", "reject", "passthrough"] }
        }
      }
    },
    "tests": {
      "type": "array",
      "description": "Round-trip test refs. Placeholder shape at Increment 1; populated by Increment 9's generate_round_trip_tests().",
      "items": { "type": "object" }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canonicalmodel.internal/contracts/C3/EgressLedgerEntry/1.0.json",
  "title": "C3 EgressLedgerEntry",
  "description": "Transcribed from the append_ledger() function body (Section 5.5). prevHash is null only for the genesis entry of a region's chain (Increment 1 decision, not stated explicitly in the spec); invariant I6 (unbroken hash chain for entries 2..N) is enforced at runtime by contracts/validators.py:check_i6_ledger_chain_unbroken, not by this schema alone.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entryId", "at", "region", "artefactId", "contentHash", "classification",
    "verdict", "policyVersion", "lawfulBasis", "runId", "prevHash", "hash", "signature"
  ],
  "properties": {
    "entryId": { "type": "string" },
    "at": { "$ref": "../../common/defs.json#/$defs/dateTime" },
    "region": { "$ref": "../../common/defs.json#/$defs/region" },
    "artefactId": { "type": "string" },
    "contentHash": { "$ref": "../../common/defs.json#/$defs/sha256Hex" },
    "classification": {
      "type": "array",
      "items": { "$ref": "../../common/defs.json#/$defs/sanitisationLabel" }
    },
    "verdict": { "$ref": "../../common/defs.json#/$defs/sanitisationVerdict" },
    "policyVersion": { "type": "integer", "minimum": 1 },
    "lawfulBasis": { "type": "string" },
    "approver": { "type": ["string", "null"], "description": "Set only for override rules." },
    "runId": { "$ref": "../../common/defs.json#/$defs/uuid" },
    "prevHash": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "../../common/defs.json#/$defs/sha256Hex" }
      ],
      "description": "sha256 hex of the previous entry in this region's chain, or null for the genesis entry."
    },
    "hash": { "$ref": "../../common/defs.json#/$defs/sha256Hex" },
    "signature": { "type": "string" }
  }
}

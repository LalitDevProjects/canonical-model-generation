# .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Project-specific
extracted/
data/output/*
data/cache/*
*.log
.env
.env.local

# Run-store (Section 3.7): local, run-scoped output. Tests write under
# tmp_path, so a real run-store/ only appears from a manual local run.
run-store/

# Temporary files
*.tmp
*.bak
